# Copy to .env and fill in your key. .env is gitignored — never commit it.
# Free sandbox key (1,000 requests/month): https://railradar.in/developers
RAILRADAR_API_KEY=rr_live_your_key_here

# Supabase — run src/store/schema.sql in the SQL editor first.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-anon-key

# Supabase → Project Settings → API → JWT Secret. Needed to verify sign-ins.
SUPABASE_JWT_SECRET=jwt-secret-goes-here
