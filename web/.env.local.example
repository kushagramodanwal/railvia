# Copy to web/.env.local. These two are public by design (the anon key is
# safe in a browser — row-level security is what protects the data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Where the FastAPI service runs.
NEXT_PUBLIC_API_ORIGIN=http://localhost:8077
